<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oa_w_bg_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="#FFEEEAE2"
                android:textSize="42sp" />
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:format12Hour="d MMMM, EEEE"
                android:format24Hour="d MMMM, EEEE"
                android:maxLines="1"
                android:textColor="#FFB7BACA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/w_simge"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/oa_w_parcali" />
                <TextView
                    android:id="@+id/w_derece"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:textColor="#FFEEEAE2"
                    android:textSize="30sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/w_sehir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxWidth="160dp"
                android:maxLines="2"
                android:gravity="end"
                android:textColor="#FF9EA2B3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/w_cizgi"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#14FFFFFF" />

    <LinearLayout
        android:id="@+id/w_tahmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/f0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/f0_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9EA2B3"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/f0_i"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/oa_w_bulut" />
            <TextView
                android:id="@+id/f0_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFEEEAE2"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/f1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/f1_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9EA2B3"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/f1_i"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/oa_w_bulut" />
            <TextView
                android:id="@+id/f1_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFEEEAE2"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/f2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/f2_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9EA2B3"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/f2_i"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/oa_w_bulut" />
            <TextView
                android:id="@+id/f2_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFEEEAE2"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/f3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/f3_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9EA2B3"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/f3_i"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:src="@drawable/oa_w_bulut" />
            <TextView
                android:id="@+id/f3_t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFEEEAE2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
